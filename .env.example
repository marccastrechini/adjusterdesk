# Local SQLite database used by Prisma on the main demo computer.
DATABASE_URL="file:./prisma/dev.db"

# Required for any local demo or staging server started with `next start`.
# Use a long random string and keep the real value only in your local `.env`.
AUTH_SECRET="replace-with-a-long-random-secret"

# Base URL used in absolute app links (including password reset links).
# Local default:
APP_BASE_URL=http://localhost:3000

# Transactional email provider used by app-sent email.
EMAIL_PROVIDER=resend

# Keep blank in source control. Set only in local `.env` or deployment env.
RESEND_API_KEY=

# Outbound sender and reply-to for system email.
SYSTEM_EMAIL_FROM="AdjusterDesk <hello@adjusterdesk.xyz>"
SYSTEM_EMAIL_REPLY_TO=hello@adjusterdesk.xyz

# Password reset token lifetime in minutes.
PASSWORD_RESET_TOKEN_MINUTES=30

# System operator login email (configuration clarity only).
SYSTEM_ADMIN_EMAIL=admin@adjusterdesk.xyz

# Optional display name used by the UI.
NEXT_PUBLIC_APP_NAME="AdjusterDesk"
