# Local development example for Stripe test mode.
# Copy to .env.development.local and fill test values.
# Blank values and placeholders only.
# Do not commit real whsec/sk_live/sk_test values.
# Sandbox webhook secrets belong in the env file for whichever app URL the sandbox endpoint sends to.

# App/runtime
APP_ENV=
APP_BASE_URL=
NEXT_PUBLIC_APP_NAME="PA ClaimBoard"
NEXT_PUBLIC_SITE_URL=
DATABASE_URL=
UPLOADS_DIR=
AUTH_SECRET=

# Analytics & SEO
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-QM2L44CMB2
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# SaaS billing
SELF_SERVICE_SIGNUP_ENABLED=
BILLING_PROVIDER=
STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET is for /api/stripe/webhook, PA ClaimBoard SaaS subscription billing.
STRIPE_WEBHOOK_SECRET=
# STRIPE_CONNECT_WEBHOOK_SECRET is for /api/stripe/connect-webhook, connected-account client payments.
STRIPE_CONNECT_WEBHOOK_SECRET=
# STRIPE_CONNECT_V2_WEBHOOK_SECRET is for /api/stripe/connect-v2-webhook, Accounts v2 thin events from your account.
STRIPE_CONNECT_V2_WEBHOOK_SECRET=
STRIPE_PRICE_SOLO_MONTHLY=
STRIPE_PRICE_SMALL_OFFICE_MONTHLY=
STRIPE_PRICE_TEAM_MONTHLY=
# Optional founding-offer prices (offer=founding). Leave blank until those Stripe prices exist.
# Unset: founding Checkout keeps the standard price and 14-day trial.
# Set: Solo / Small Office founding Checkout uses these prices and a 90-day trial.
# Create new price IDs. Do not edit the standard price IDs above.
STRIPE_PRICE_FOUNDING_SOLO_MONTHLY=
STRIPE_PRICE_FOUNDING_SMALL_OFFICE_MONTHLY=

# Client Payments / Stripe Connect
CLIENT_BILLING_PROVIDERS_ENABLED=
STRIPE_CONNECT_CLIENT_PAYMENTS_ENABLED=

# Client Payments / QuickBooks Online
# Hidden until INTUIT_CLIENT_ID and INTUIT_CLIENT_SECRET are set.
# INTUIT_ENVIRONMENT defaults to sandbox. Use production only for the live Intuit app.
# INTUIT_REDIRECT_URI must match the Intuit app exactly.
# Sandbox callback: https://sandbox.paclaimboard.com/api/integrations/quickbooks/callback
# Production callback: https://paclaimboard.com/api/integrations/quickbooks/callback
# Sandbox webhook: https://sandbox.paclaimboard.com/api/integrations/quickbooks/webhook
# Production webhook: https://paclaimboard.com/api/integrations/quickbooks/webhook
INTUIT_CLIENT_ID=
INTUIT_CLIENT_SECRET=
INTUIT_REDIRECT_URI=
INTUIT_ENVIRONMENT=
INTUIT_WEBHOOK_VERIFIER_TOKEN=
# Optional. Encrypts stored QuickBooks tokens. When unset, INTUIT_CLIENT_SECRET is the key.
INTUIT_TOKEN_ENCRYPTION_KEY=

# Email
EMAIL_PROVIDER=
RESEND_API_KEY=
SYSTEM_EMAIL_FROM="PA ClaimBoard <hello@paclaimboard.com>"
SYSTEM_EMAIL_REPLY_TO=hello@paclaimboard.com
PASSWORD_RESET_TOKEN_MINUTES=
USER_INVITATION_TOKEN_MINUTES=
SYSTEM_ADMIN_EMAIL=admin@paclaimboard.com
