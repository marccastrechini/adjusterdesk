APP_ENV=development
APP_BASE_URL=http://localhost:3000
DATABASE_URL=file:./prisma/dev.db
UPLOADS_DIR=storage/uploads-development
AUTH_SECRET=replace-with-a-long-random-secret
EMAIL_PROVIDER=resend
