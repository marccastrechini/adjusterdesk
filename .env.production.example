# Production template.
# Blank values and placeholders only.
# Do not commit real whsec/sk_live/sk_test values.
# Sandbox webhook secrets belong in the env file for whichever app URL the sandbox endpoint sends to.

# App/runtime
APP_ENV=
APP_BASE_URL=
NEXT_PUBLIC_APP_NAME=
NEXT_PUBLIC_SITE_URL=
DATABASE_URL=
UPLOADS_DIR=
AUTH_SECRET=

# Analytics & SEO
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-QM2L44CMB2
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# SaaS billing
SELF_SERVICE_SIGNUP_ENABLED=
BILLING_PROVIDER=
STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET is for /api/stripe/webhook, AdjusterDesk SaaS subscription billing.
STRIPE_WEBHOOK_SECRET=
# STRIPE_CONNECT_WEBHOOK_SECRET is for /api/stripe/connect-webhook, connected-account client payments.
STRIPE_CONNECT_WEBHOOK_SECRET=
STRIPE_PRICE_SOLO_MONTHLY=
STRIPE_PRICE_SMALL_OFFICE_MONTHLY=
STRIPE_PRICE_TEAM_MONTHLY=
# Optional founding-offer prices (offer=founding). Leave blank until those Stripe prices exist.
# Unset: founding Checkout keeps the standard price and 14-day trial.
# Set: Solo / Small Office founding Checkout uses these prices and a 90-day trial.
# Create new price IDs. Do not edit the standard price IDs above.
STRIPE_PRICE_FOUNDING_SOLO_MONTHLY=
STRIPE_PRICE_FOUNDING_SMALL_OFFICE_MONTHLY=

# Client Payments / Stripe Connect
CLIENT_BILLING_PROVIDERS_ENABLED=
STRIPE_CONNECT_CLIENT_PAYMENTS_ENABLED=

# Email
EMAIL_PROVIDER=
RESEND_API_KEY=
SYSTEM_EMAIL_FROM="AdjusterDesk <hello@adjusterdesk.xyz>"
SYSTEM_EMAIL_REPLY_TO=hello@adjusterdesk.xyz
PASSWORD_RESET_TOKEN_MINUTES=
USER_INVITATION_TOKEN_MINUTES=
SYSTEM_ADMIN_EMAIL=admin@adjusterdesk.xyz