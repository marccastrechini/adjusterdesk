APP_ENV=production
APP_BASE_URL=https://adjusterdesk.xyz
DATABASE_URL=file:./prisma/production.db
UPLOADS_DIR=storage/uploads-production
AUTH_SECRET=replace-with-a-long-random-secret
EMAIL_PROVIDER=resend
RESEND_API_KEY=
