# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results/
/playwright-report/
/blob-report/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env
.env.local
.env.development.local
.env.production.local
.env*
!.env.example
!.env.development.example
!.env.production.example
!.env.development.local.example
!.env.production.local.example

# local data
/prisma/dev.db
/prisma/dev.db-journal
/prisma/dev.db-wal
/prisma/dev.db-shm
/prisma/production.db
/prisma/production.db-journal
/prisma/production.db-wal
/prisma/production.db-shm
/storage/uploads/*
!/storage/uploads/.gitkeep
/storage/uploads-development/
/storage/uploads-production/
/backups/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma
